<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>zh_CN</string>
    <key>CFBundleExecutable</key>
    <string>English</string>
    <!-- 中性占位值。真正的 id 由 package_app.sh 用 PlistBuddy 写进来
         （默认同上，可用 Scripts/local.env 覆盖）。不写死是为了：
         仓库能公开、而且换 id 是每台机器自己的事。 -->
    <key>CFBundleIdentifier</key>
    <string>dev.hardsub.english</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>English</string>
    <key>CFBundleDisplayName</key>
    <string>硬字幕学习</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>15.0</string>

    <!-- 菜单栏 App：不占 Dock、不占 Cmd-Tab -->
    <key>LSUIElement</key>
    <true/>

    <!-- 缺这一条：Retina 屏会被按 1x 渲染，
         抓屏算出来的 scale 变成 1.0，OCR 精度直接砍半 -->
    <key>NSHighResolutionCapable</key>
    <true/>

    <!-- 缺这一条：AppKit 不会正确初始化（窗口、菜单都会不正常） -->
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>

    <!-- 缺这一条：TCC 会**静默拒绝**甚至直接 SIGKILL，且不弹授权框 -->
    <key>NSScreenCaptureUsageDescription</key>
    <string>需要录制屏幕，才能读取画面里烧录的硬字幕并沉淀成学习材料。</string>
</dict>
</plist>
